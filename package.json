{
  "name": "@geekflare/api-node",
  "version": "0.1.3",
  "description": "Official Node.js / TypeScript SDK for Geekflare API",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "openapi-ts",
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geekflare/geekflare-api-node.git"
  },
  "keywords": [
    "geekflare",
    "api",
    "sdk",
    "scraping",
    "screenshot",
    "dns",
    "search"
  ],
  "author": "Geekflare",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/geekflare/geekflare-api-node/issues"
  },
  "homepage": "https://github.com/geekflare/geekflare-api-node#readme",
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.97.0",
    "@types/node": "^25.6.0",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
